name: GreenPMS Retention

on:
  schedule:
    - cron: '17 3 * * *'
  workflow_dispatch:
    inputs:
      dry_run:
        description: Preview retention and local cleanup without deleting resources
        required: false
        default: true
        type: boolean

permissions:
  contents: read

concurrency:
  group: greenpms-production
  cancel-in-progress: false

env:
  COS_PREFIX: greenpms/releases/
  COS_ENDPOINT: ${{ vars.COS_ENDPOINT }}

jobs:
  maintenance:
    name: Retain successful releases and prune local images
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    environment: production
    env:
      COS_BUCKET: ${{ vars.COS_BUCKET }}
      COS_REGION: ${{ vars.COS_REGION }}
      RETENTION_COS_BUCKET: ${{ vars.COS_BUCKET }}
      RETENTION_COS_REGION: ${{ vars.COS_REGION }}
      DEPLOY_HOST: ${{ vars.DEPLOY_HOST }}
      DEPLOY_USER: ${{ vars.DEPLOY_USER }}
    steps:
      - name: Check out maintenance tools
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false

      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.x'

      - name: Install COS client dependencies
        run: python3 -m pip install --disable-pip-version-check --no-input -r scripts/release/requirements.txt

      - name: Materialize restricted SSH files
        env:
          DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
          DEPLOY_KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
          DEPLOY_SSH_KEY_FILE: ${{ runner.temp }}/greenpms-retention-key
          DEPLOY_KNOWN_HOSTS_FILE: ${{ runner.temp }}/greenpms-retention-known-hosts
        run: |
          set -eu
          umask 077
          printf '%s\n' "$DEPLOY_SSH_KEY" > "$DEPLOY_SSH_KEY_FILE"
          printf '%s\n' "$DEPLOY_KNOWN_HOSTS" > "$DEPLOY_KNOWN_HOSTS_FILE"
          chmod 600 "$DEPLOY_SSH_KEY_FILE" "$DEPLOY_KNOWN_HOSTS_FILE"

      - name: Run maintenance
        env:
          RETENTION_COS_SECRET_ID: ${{ secrets.RETENTION_COS_SECRET_ID }}
          RETENTION_COS_SECRET_KEY: ${{ secrets.RETENTION_COS_SECRET_KEY }}
          RETENTION_COS_TOKEN: ${{ secrets.RETENTION_COS_TOKEN }}
          DEPLOY_SSH_KEY_FILE: ${{ runner.temp }}/greenpms-retention-key
          DEPLOY_KNOWN_HOSTS_FILE: ${{ runner.temp }}/greenpms-retention-known-hosts
          RETENTION_DRY_RUN: ${{ inputs.dry_run || 'false' }}
        run: |
          set -eu
          if [ "$RETENTION_DRY_RUN" = "true" ]; then
            python3 scripts/release/orchestrate.py maintenance --dry-run
          else
            python3 scripts/release/orchestrate.py maintenance
          fi

      - name: Write maintenance summary
        if: success()
        env:
          RETENTION_DRY_RUN: ${{ inputs.dry_run || 'false' }}
        run: |
          set -eu
          printf '### GreenPMS maintenance\n\n- Mode: `%s`\n- Checks: immutable release retention and protected local image cleanup passed\n' \
            "$([ "$RETENTION_DRY_RUN" = "true" ] && printf dry-run || printf apply)" >> "$GITHUB_STEP_SUMMARY"

      - name: Remove temporary SSH files
        if: always()
        env:
          DEPLOY_SSH_KEY_FILE: ${{ runner.temp }}/greenpms-retention-key
          DEPLOY_KNOWN_HOSTS_FILE: ${{ runner.temp }}/greenpms-retention-known-hosts
        run: |
          set +e
          rm -f -- "$DEPLOY_SSH_KEY_FILE" "$DEPLOY_KNOWN_HOSTS_FILE"
          exit 0
