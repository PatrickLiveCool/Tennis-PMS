name: GreenPMS Release

on:
  release:
    types: [published]
  workflow_dispatch:
    inputs:
      release_tag:
        description: Published release tag to replay, for example v1.3.0
        required: true
        type: string

permissions:
  contents: read

# Upload, deployment, and maintenance share one lock. A retention run cannot
# delete a candidate while this workflow is uploading or promoting it.
concurrency:
  group: greenpms-production
  cancel-in-progress: false

env:
  COS_PREFIX: greenpms/releases/
  COS_ENDPOINT: ${{ vars.COS_ENDPOINT }}
  DOCKER_DEFAULT_PLATFORM: linux/amd64

jobs:
  validate:
    name: Validate tagged release
    if: (github.event_name == 'release' && github.event.release.draft == false && github.event.release.prerelease == false) || (github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main')
    runs-on: ubuntu-latest
    timeout-minutes: 35
    outputs:
      release_tag: ${{ steps.release.outputs.tag }}
      release_sha: ${{ steps.release.outputs.sha }}
      harness_sha: ${{ steps.release.outputs.harness_sha }}
    env:
      CI: true
      NODE_ENV: test
    steps:
      - name: Check out trusted release harness
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          path: harness
          fetch-depth: 1
          ref: main
          persist-credentials: false

      - name: Check out immutable release source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          path: source
          fetch-depth: 0
          ref: ${{ github.event_name == 'release' && github.event.release.tag_name || inputs.release_tag }}
          persist-credentials: false

      - name: Set up Node.js 22
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: 22.x
          cache: npm
          cache-dependency-path: source/package-lock.json

      - name: Install dependencies
        working-directory: source
        run: npm ci

      - name: Resolve release identity
        id: release
        env:
          RELEASE_TAG: ${{ github.event_name == 'release' && github.event.release.tag_name || inputs.release_tag }}
        working-directory: source
        run: |
          set -eu
          printf '%s\n' "$RELEASE_TAG" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
          release_sha="$(git rev-parse "refs/tags/$RELEASE_TAG^{commit}")"
          harness_sha="$(git -C ../harness rev-parse HEAD)"
          printf 'tag=%s\nsha=%s\nharness_sha=%s\n' \
            "$RELEASE_TAG" "$release_sha" "$harness_sha" >> "$GITHUB_OUTPUT"

      - name: Verify tag identity and main ancestry
        env:
          RELEASE_TAG: ${{ steps.release.outputs.tag }}
          RELEASE_SHA: ${{ steps.release.outputs.sha }}
          HARNESS_SHA: ${{ steps.release.outputs.harness_sha }}
        working-directory: source
        run: |
          set -eu
          printf '%s\n' "$RELEASE_TAG" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
          test "$(git rev-parse HEAD)" = "$RELEASE_SHA"
          test "$(git rev-parse "refs/tags/$RELEASE_TAG^{commit}")" = "$RELEASE_SHA"
          git show-ref --verify --quiet refs/remotes/origin/main
          git merge-base --is-ancestor "$RELEASE_SHA" origin/main
          test -z "$(git status --porcelain)"
          test "$(git -C ../harness rev-parse HEAD)" = "$HARNESS_SHA"
          test -z "$(git -C ../harness status --porcelain)"

      - name: Verify manually replayed release is published
        if: github.event_name == 'workflow_dispatch'
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_TAG: ${{ inputs.release_tag }}
        run: |
          set -eu
          published_tag="$(gh api "repos/${GITHUB_REPOSITORY}/releases/tags/${RELEASE_TAG}" \
            --jq 'select(.draft == false and .prerelease == false) | .tag_name')"
          test "$published_tag" = "$RELEASE_TAG"

      - name: Check package, lockfile, changelog, and notes
        env:
          RELEASE_TAG: ${{ github.event_name == 'release' && github.event.release.tag_name || inputs.release_tag }}
        run: node harness/scripts/check-release.mjs --root source --tag "$RELEASE_TAG"

      - name: Typecheck
        working-directory: source
        run: npm run typecheck

      - name: Test
        working-directory: source
        run: npm run test

      - name: Build
        working-directory: source
        run: npm run build

      - name: Test release harness
        working-directory: harness
        run: python3 -m unittest discover -s scripts/release/tests -v

  package-upload:
    name: Package and upload immutable release
    needs: validate
    runs-on: ubuntu-latest
    timeout-minutes: 30
    environment: production
    outputs:
      version: ${{ steps.package.outputs.version }}
      revision: ${{ steps.package.outputs.revision }}
      key: ${{ steps.package.outputs.key }}
      manifest_sha: ${{ steps.package.outputs.manifest_sha }}
    env:
      COS_BUCKET: ${{ vars.COS_BUCKET }}
      COS_REGION: ${{ vars.COS_REGION }}
      UPLOAD_COS_BUCKET: ${{ vars.COS_BUCKET }}
      UPLOAD_COS_REGION: ${{ vars.COS_REGION }}
    steps:
      - name: Verify release infrastructure configuration
        env:
          UPLOAD_COS_SECRET_ID: ${{ secrets.UPLOAD_COS_SECRET_ID }}
          UPLOAD_COS_SECRET_KEY: ${{ secrets.UPLOAD_COS_SECRET_KEY }}
          RETENTION_COS_SECRET_ID: ${{ secrets.RETENTION_COS_SECRET_ID }}
          RETENTION_COS_SECRET_KEY: ${{ secrets.RETENTION_COS_SECRET_KEY }}
          DEPLOY_HOST: ${{ vars.DEPLOY_HOST }}
          DEPLOY_USER: ${{ vars.DEPLOY_USER }}
          DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
          DEPLOY_KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
        run: |
          set -eu
          missing=""
          for name in COS_BUCKET COS_REGION UPLOAD_COS_SECRET_ID UPLOAD_COS_SECRET_KEY \
            RETENTION_COS_SECRET_ID RETENTION_COS_SECRET_KEY DEPLOY_HOST DEPLOY_USER \
            DEPLOY_SSH_KEY DEPLOY_KNOWN_HOSTS; do
            if [ -z "${!name:-}" ]; then
              missing="${missing}${missing:+, }${name}"
            fi
          done
          if [ -n "$missing" ]; then
            printf 'Missing GreenPMS release configuration: %s\n' "$missing" >&2
            exit 1
          fi

      - name: Check out trusted release harness
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          path: harness
          fetch-depth: 1
          ref: ${{ needs.validate.outputs.harness_sha }}
          persist-credentials: false

      - name: Check out immutable release source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          path: source
          fetch-depth: 0
          ref: ${{ needs.validate.outputs.release_tag }}
          persist-credentials: false

      - name: Resolve release identity
        id: release
        env:
          RELEASE_TAG: ${{ needs.validate.outputs.release_tag }}
          RELEASE_SHA: ${{ needs.validate.outputs.release_sha }}
          HARNESS_SHA: ${{ needs.validate.outputs.harness_sha }}
        run: |
          set -eu
          printf '%s\n' "$RELEASE_TAG" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
          test "$(git -C source rev-parse HEAD)" = "$RELEASE_SHA"
          test "$(git -C source rev-parse "refs/tags/$RELEASE_TAG^{commit}")" = "$RELEASE_SHA"
          test "$(git -C harness rev-parse HEAD)" = "$HARNESS_SHA"
          test -z "$(git -C source status --porcelain)"
          test -z "$(git -C harness status --porcelain)"
          printf 'tag=%s\nsha=%s\n' "$RELEASE_TAG" "$RELEASE_SHA" >> "$GITHUB_OUTPUT"

      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.x'

      - name: Install COS client dependencies
        run: python3 -m pip install --disable-pip-version-check --no-input -r harness/scripts/release/requirements.txt

      - name: Install pinned Syft and verify its official checksum
        env:
          SYFT_VERSION: 1.18.1
        run: |
          set -eu
          syft_dir="$RUNNER_TEMP/greenpms-syft"
          mkdir -p "$syft_dir"
          archive="syft_${SYFT_VERSION}_linux_amd64.tar.gz"
          curl --fail --silent --show-error --location \
            --output "$syft_dir/checksums.txt" \
            "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_checksums.txt"
          curl --fail --silent --show-error --location \
            --output "$syft_dir/$archive" \
            "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/$archive"
          expected="$(awk -v name="$archive" '$2 == name { print $1 }' "$syft_dir/checksums.txt")"
          test -n "$expected"
          printf '%s  %s\n' "$expected" "$syft_dir/$archive" | sha256sum --check --status
          tar -xzf "$syft_dir/$archive" -C "$syft_dir"
          test -x "$syft_dir/syft"
          echo "$syft_dir" >> "$GITHUB_PATH"

      - name: Reuse an existing verified bundle when retrying
        id: bundle
        env:
          RELEASE_DIR_ROOT: ${{ runner.temp }}/greenpms-release
          RELEASE_VERSION: ${{ steps.release.outputs.tag }}
          RELEASE_REVISION: ${{ steps.release.outputs.sha }}
          UPLOAD_COS_SECRET_ID: ${{ secrets.UPLOAD_COS_SECRET_ID }}
          UPLOAD_COS_SECRET_KEY: ${{ secrets.UPLOAD_COS_SECRET_KEY }}
          UPLOAD_COS_TOKEN: ${{ secrets.UPLOAD_COS_TOKEN }}
        run: |
          set -eu
          version="$RELEASE_VERSION"
          revision="$RELEASE_REVISION"
          release_dir="$(mktemp -d "${RELEASE_DIR_ROOT}.XXXXXX")"
          test -z "$(git -C source status --porcelain)"
          # Retry the same release using its verified immutable COS bundle.
          # Only a completely absent prefix may be built; partial uploads fail closed.
          fetch_status=0
          python3 harness/scripts/release/cos.py fetch --version "$version" \
            --revision "$revision" --directory "$release_dir" || fetch_status=$?
          if [ "$fetch_status" != 0 ] && [ "$fetch_status" != 3 ]; then
            exit "$fetch_status"
          fi
          printf 'directory=%s\nfetch_status=%s\n' "$release_dir" "$fetch_status" >> "$GITHUB_OUTPUT"

      - name: Build and package without cloud credentials
        if: steps.bundle.outputs.fetch_status == '3'
        env:
          RELEASE_VERSION: ${{ steps.release.outputs.tag }}
          RELEASE_REVISION: ${{ steps.release.outputs.sha }}
          RELEASE_DIRECTORY: ${{ steps.bundle.outputs.directory }}
        run: |
          set -eu
          python3 harness/scripts/release/package.py --version "$RELEASE_VERSION" \
            --revision "$RELEASE_REVISION" --source-root "$GITHUB_WORKSPACE/source" \
            --output "$RELEASE_DIRECTORY"

      - name: Upload immutable release and verify stored bytes
        id: package
        env:
          RELEASE_VERSION: ${{ steps.release.outputs.tag }}
          RELEASE_REVISION: ${{ steps.release.outputs.sha }}
          RELEASE_DIRECTORY: ${{ steps.bundle.outputs.directory }}
          UPLOAD_COS_SECRET_ID: ${{ secrets.UPLOAD_COS_SECRET_ID }}
          UPLOAD_COS_SECRET_KEY: ${{ secrets.UPLOAD_COS_SECRET_KEY }}
          UPLOAD_COS_TOKEN: ${{ secrets.UPLOAD_COS_TOKEN }}
        run: |
          set -eu
          version="$RELEASE_VERSION"
          revision="$RELEASE_REVISION"
          release_dir="$RELEASE_DIRECTORY"
          test -f "$release_dir/manifest.json"
          test -f "$release_dir/SHA256SUMS"
          test -f "$release_dir/sbom.spdx.json"
          python3 harness/scripts/release/cos.py upload \
            --directory "$release_dir" \
            --prefix "$COS_PREFIX"
          manifest_sha="$(sha256sum "$release_dir/manifest.json" | awk '{print $1}')"
          key="${COS_PREFIX}${version}/${revision}/"
          {
            printf 'version=%s\n' "$version"
            printf 'revision=%s\n' "$revision"
            printf 'key=%s\n' "$key"
            printf 'manifest_sha=%s\n' "$manifest_sha"
          } >> "$GITHUB_OUTPUT"

      - name: Write release summary
        if: success()
        env:
          RELEASE_VERSION: ${{ steps.release.outputs.tag }}
          RELEASE_REVISION: ${{ steps.release.outputs.sha }}
        run: |
          set -eu
          printf '### GreenPMS release package\n\n- Version: `%s`\n- Commit: `%s`\n- Checks: metadata, tests, image labels, archive, checksum, and SBOM passed\n' \
            "$RELEASE_VERSION" "$RELEASE_REVISION" >> "$GITHUB_STEP_SUMMARY"

      - name: Clean runner release files and BuildKit cache
        if: always()
        run: |
          set +e
          rm -rf -- "$RUNNER_TEMP/greenpms-release."* "$RUNNER_TEMP/greenpms-syft"
          docker buildx prune --all --force >/dev/null 2>&1
          docker buildx rm --all-inactive --force >/dev/null 2>&1
          exit 0

  deploy:
    name: Deploy approved release
    needs: [validate, package-upload]
    runs-on: ubuntu-latest
    timeout-minutes: 20
    environment: production
    env:
      DEPLOY_HOST: ${{ vars.DEPLOY_HOST }}
      DEPLOY_USER: ${{ vars.DEPLOY_USER }}
      COS_BUCKET: ${{ vars.COS_BUCKET }}
      COS_REGION: ${{ vars.COS_REGION }}
      MARKER_COS_BUCKET: ${{ vars.COS_BUCKET }}
      MARKER_COS_REGION: ${{ vars.COS_REGION }}
      RETENTION_COS_BUCKET: ${{ vars.COS_BUCKET }}
      RETENTION_COS_REGION: ${{ vars.COS_REGION }}
    steps:
      - name: Check out trusted deployment tools
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          path: harness
          fetch-depth: 1
          ref: ${{ needs.validate.outputs.harness_sha }}
          persist-credentials: false

      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.x'

      - name: Install COS client dependencies
        run: python3 -m pip install --disable-pip-version-check --no-input -r harness/scripts/release/requirements.txt

      - name: Materialize restricted SSH files
        env:
          DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
          DEPLOY_KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
          DEPLOY_SSH_KEY_FILE: ${{ runner.temp }}/greenpms-deploy-key
          DEPLOY_KNOWN_HOSTS_FILE: ${{ runner.temp }}/greenpms-deploy-known-hosts
        run: |
          set -eu
          umask 077
          printf '%s\n' "$DEPLOY_SSH_KEY" > "$DEPLOY_SSH_KEY_FILE"
          printf '%s\n' "$DEPLOY_KNOWN_HOSTS" > "$DEPLOY_KNOWN_HOSTS_FILE"
          chmod 600 "$DEPLOY_SSH_KEY_FILE" "$DEPLOY_KNOWN_HOSTS_FILE"

      - name: Deploy through the restricted server entry point
        env:
          # Same CAM upload identity; health gating belongs to trusted workflow/server code.
          MARKER_COS_SECRET_ID: ${{ secrets.UPLOAD_COS_SECRET_ID }}
          MARKER_COS_SECRET_KEY: ${{ secrets.UPLOAD_COS_SECRET_KEY }}
          MARKER_COS_TOKEN: ${{ secrets.UPLOAD_COS_TOKEN }}
          RETENTION_COS_SECRET_ID: ${{ secrets.RETENTION_COS_SECRET_ID }}
          RETENTION_COS_SECRET_KEY: ${{ secrets.RETENTION_COS_SECRET_KEY }}
          RETENTION_COS_TOKEN: ${{ secrets.RETENTION_COS_TOKEN }}
          DEPLOY_SSH_KEY_FILE: ${{ runner.temp }}/greenpms-deploy-key
          DEPLOY_KNOWN_HOSTS_FILE: ${{ runner.temp }}/greenpms-deploy-known-hosts
          RELEASE_VERSION: ${{ needs.package-upload.outputs.version }}
          RELEASE_REVISION: ${{ needs.package-upload.outputs.revision }}
          RELEASE_KEY: ${{ needs.package-upload.outputs.key }}
          RELEASE_MANIFEST_SHA: ${{ needs.package-upload.outputs.manifest_sha }}
        run: |
          set -eu
          python3 harness/scripts/release/orchestrate.py deploy \
            --version "$RELEASE_VERSION" \
            --revision "$RELEASE_REVISION" \
            --key "$RELEASE_KEY" \
            --manifest-sha "$RELEASE_MANIFEST_SHA"

      - name: Write deployment summary
        if: success()
        env:
          RELEASE_VERSION: ${{ needs.package-upload.outputs.version }}
          RELEASE_REVISION: ${{ needs.package-upload.outputs.revision }}
        run: |
          set -eu
          printf '### GreenPMS deployment\n\n- Version: `%s`\n- Commit: `%s`\n- Checks: server deployment, health checks, and success marker passed\n' \
            "$RELEASE_VERSION" "$RELEASE_REVISION" >> "$GITHUB_STEP_SUMMARY"

      - name: Remove temporary SSH files
        if: always()
        env:
          DEPLOY_SSH_KEY_FILE: ${{ runner.temp }}/greenpms-deploy-key
          DEPLOY_KNOWN_HOSTS_FILE: ${{ runner.temp }}/greenpms-deploy-known-hosts
        run: |
          set +e
          rm -f -- "$DEPLOY_SSH_KEY_FILE" "$DEPLOY_KNOWN_HOSTS_FILE"
          exit 0
