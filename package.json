{
  "name": "qintopia-pms",
  "version": "1.4.3",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "release:check": "node scripts/check-release.mjs",
    "build": "vite build --config apps/web/vite.tennis.config.ts",
    "dev": "concurrently --kill-others-on-fail -n api,web 'npm run tennis:api' 'npm run tennis:web'",
    "start": "npm run dev",
    "tennis:api": "node --import tsx scripts/tennis/server.mts",
    "tennis:web": "vite --config apps/web/vite.tennis.config.ts",
    "tennis:preview": "vite preview --config apps/web/vite.tennis.config.ts",
    "tennis:demo": "node --import tsx scripts/tennis/demo.mts",
    "integration:worker": "node scripts/tennis/legacy-disabled.mjs",
    "wecom:worker": "node scripts/tennis/legacy-disabled.mjs",
    "db:migrate": "npm run tennis:db:migrate",
    "db:ready": "node scripts/tennis/legacy-disabled.mjs",
    "db:import:2026": "node scripts/tennis/legacy-disabled.mjs",
    "db:seed": "node scripts/tennis/legacy-disabled.mjs",
    "db:reset": "node scripts/tennis/legacy-disabled.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.contract.test.ts' --exclude 'tests/e2e/**'",
    "test:integration": "vitest run --config vitest.tennis-integration.config.ts",
    "test:integration:lock-runner": "node scripts/tennis/legacy-disabled.mjs",
    "test:integration:run": "node scripts/tennis/legacy-disabled.mjs",
    "test:contract": "node scripts/tennis/legacy-disabled.mjs",
    "test:contract:run": "node scripts/tennis/legacy-disabled.mjs",
    "test:e2e": "node scripts/tennis/legacy-disabled.mjs",
    "test:e2e:run": "node scripts/tennis/legacy-disabled.mjs",
    "test:pricing-facts": "node scripts/tennis/legacy-disabled.mjs",
    "data:purge:local-acceptance": "node scripts/tennis/legacy-disabled.mjs",
    "data:setup:room-status-visual": "node scripts/tennis/legacy-disabled.mjs",
    "data:setup:temporary-other-room": "node scripts/tennis/legacy-disabled.mjs",
    "backup": "node scripts/tennis/legacy-disabled.mjs",
    "verify:restore": "node scripts/tennis/legacy-disabled.mjs",
    "verify:cold-start": "node scripts/tennis/legacy-disabled.mjs",
    "verify:compose": "node scripts/tennis/legacy-disabled.mjs",
    "verify": "npm run typecheck && npm run test",
    "test:all": "node scripts/tennis/legacy-disabled.mjs",
    "test:release": "node scripts/tennis/legacy-disabled.mjs",
    "tennis:db:up": "docker compose up -d --wait postgres",
    "tennis:db:migrate": "node --import tsx scripts/tennis/database.mts",
    "test:tennis": "vitest run --config vitest.tennis.config.ts",
    "verify:tennis": "npm run typecheck && npm run test:tennis && npm run test:integration"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@sinclair/typebox": "^0.34.38",
    "fastify": "^5.4.0",
    "kysely": "^0.28.5",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.542.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
