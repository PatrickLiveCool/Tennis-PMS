{
  "name": "qintopia-pms",
  "version": "1.4.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "release:check": "node scripts/check-release.mjs",
    "build": "npm run release:check && npm run build -w @qintopia/web",
    "dev": "concurrently -k -n api,web -c green,blue \"npm run dev -w @qintopia/api\" \"npm run dev -w @qintopia/web\"",
    "start": "npm run start -w @qintopia/api",
    "integration:worker": "node --import tsx packages/db/src/integration-worker-main.ts",
    "wecom:worker": "node --import tsx packages/db/src/wecom-worker-main.ts",
    "db:migrate": "npm run migrate -w @qintopia/db",
    "db:ready": "npm run ready -w @qintopia/db",
    "db:import:2026": "npm run import:reference-catalog -w @qintopia/db --",
    "db:seed": "npm run seed -w @qintopia/db",
    "db:reset": "npm run reset -w @qintopia/db",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.contract.test.ts' --exclude 'tests/e2e/**'",
    "test:integration": "npm run test:integration:lock-runner && node --import tsx tests/helpers/run-database-test-suite.ts -- npm run test:integration:run --",
    "test:integration:lock-runner": "vitest run tests/integration/test-suite-runner.integration.test.ts",
    "test:integration:run": "node --import tsx tests/helpers/assert-database-test-lock.ts && vitest run tests/integration --exclude tests/integration/test-suite-runner.integration.test.ts",
    "test:contract": "node --import tsx tests/helpers/run-database-test-suite.ts -- npm run test:contract:run --",
    "test:contract:run": "node --import tsx tests/helpers/assert-database-test-lock.ts && npm run build && vitest run tests/contract",
    "test:e2e": "node --import tsx tests/helpers/run-database-test-suite.ts -- npm run test:e2e:run --",
    "test:e2e:run": "node --import tsx tests/helpers/assert-database-test-lock.ts && VITE_DEMO_LOGIN=true WEB_BUILD_OUT_DIR=dist-e2e npm run build && node --import tsx tests/e2e/setup-database.ts && playwright test",
    "test:pricing-facts": "node --import tsx tests/pricing-facts/verify-pricing-facts.ts",
    "data:purge:local-acceptance": "node --import tsx scripts/purge-local-acceptance-business-data.ts",
    "data:setup:room-status-visual": "node --import tsx tests/e2e/setup-room-status-visual-acceptance.ts",
    "data:setup:temporary-other-room": "node --import tsx tests/e2e/setup-temporary-other-room-acceptance.ts",
    "backup": "./scripts/backup.sh",
    "verify:restore": "bash ./scripts/verify-backup-restore.sh",
    "verify:cold-start": "bash ./scripts/verify-cold-start.sh",
    "verify:compose": "bash ./scripts/verify-compose-cold-start.sh",
    "verify": "npm run typecheck && npm run test",
    "test:all": "npm run verify && npm run test:integration && npm run test:contract && npm run test:e2e && npm run test:pricing-facts",
    "test:release": "python3 -m unittest discover -s scripts/release/tests -v"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@sinclair/typebox": "^0.34.38",
    "fastify": "^5.4.0",
    "kysely": "^0.28.5",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.542.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
