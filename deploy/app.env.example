# Non-secret template. Install the populated file root-owned mode 0600.
# The administrator must preserve both current keys; never generate replacement AI keys.
TENNIS_DATABASE_URL=postgres://tennis_demo:REPLACE_IN_RESTRICTED_FILE@EXTERNAL_DATABASE_HOST:5432/tennis_demo
TENNIS_WEB_ORIGINS=https://REPLACE_WITH_TENNIS_HOST
TENNIS_TRUSTED_PROXY=REPLACE_WITH_EXACT_DOCKER_GATEWAY_IP
TENNIS_AI_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_BASE64_KEY
TENNIS_PAYMENT_SIGNING_KEY=REPLACE_WITH_EXISTING_SIGNING_KEY
TENNIS_APP_HOST_PORT=4200
# Immutable release image is supplied by the restricted deployment entry.
