ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json CHANGELOG.md ./
COPY apps apps
COPY packages packages
COPY scripts scripts
COPY deploy/release-policy.json deploy/release-policy.json
COPY docs/releases docs/releases
RUN npm ci --ignore-scripts
RUN npm run build && node scripts/build-runtime.mjs --source-root /app --output /app/runtime --demo-tools

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ARG OCI_REVISION
ARG OCI_CREATED
ENV NODE_ENV=development \
    TENNIS_DEMO_MODE=true \
    TENNIS_ALLOW_SIMULATION=true \
    TENNIS_RELEASE_VERSION=1.4.3-demo \
    TENNIS_RELEASE_REVISION=${OCI_REVISION}
LABEL org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.source="https://github.com/PatrickLiveCool/Tennis-PMS" \
      org.opencontainers.image.title="Tennis PMS simulation demo"
COPY --from=build /app/runtime/ ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
USER node
EXPOSE 4200
CMD ["node", "scripts/tennis/server-entry.mjs"]
