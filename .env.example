DATABASE_URL=postgres://qintopia:qintopia@127.0.0.1:55432/qintopia
PORT=4100
WEB_ORIGIN=http://127.0.0.1:4173
SESSION_COOKIE_SECURE=false
SEED_DEMO_DATA=true
STAFF_PROFILE_MANIFEST_NAME=demo
MIGRATION_STAFF_PROFILE_MANIFEST_NAME=unconfigured
PREVIEW_TTL_SECONDS=600
LOG_LEVEL=info
BEARER_AUTH_RATE_LIMIT_MAX=600

# Optional, separate backend worker; no API calls while disabled.
PMS_WECOM_SYNC_ENABLED=false
PMS_WECOM_SOURCE_ID=
PMS_WECOM_CORP_ID=
PMS_WECOM_APP_SECRET=
PMS_WECOM_WORKER_DATABASE_URL=
# See docs/implementation/spec-wecom-external-payments.md for merchant mapping,
# first import, the 2026-09-01 cutoff and the dedicated worker role.

# AI credential encryption: generate once with openssl rand -base64 32, retain for restore.
# Leave unset to keep AI unavailable while all ordinary PMS features remain usable.
AI_SETTINGS_ENCRYPTION_KEY=
