# Tennis-Green-PMS local defaults. Replace values marked CHANGE_ME for a shared environment.
COMPOSE_PROJECT_NAME=tennis-green-pms-local
TENNIS_DATABASE_URL=postgres://tennis_dev:tennis_local_only@127.0.0.1:55439/tennis_dev
TENNIS_TEST_DATABASE_URL=postgres://tennis_dev:tennis_local_only@127.0.0.1:55439/tennis_test
TENNIS_POSTGRES_USER=tennis_dev
TENNIS_POSTGRES_PASSWORD=tennis_local_only
TENNIS_POSTGRES_DB=tennis_dev
TENNIS_POSTGRES_HOST_PORT=55439
TENNIS_API_PORT=4200
TENNIS_WEB_PORT=4273
TENNIS_HTTP_HOST=127.0.0.1
TENNIS_ALLOW_SIMULATION=true

# Required only for a real server environment; do not commit the populated value.
# TENNIS_DATABASE_URL=postgres://USER:CHANGE_ME@DB_HOST:5432/tennis_green_pms
# TENNIS_AI_ENCRYPTION_KEY=CHANGE_ME
# TENNIS_PAYMENT_SIGNING_KEY=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
# TENNIS_WEB_ORIGINS=https://tennis.example.invalid
# TENNIS_GREEN_PMS_IMAGE=registry.example/tennis-green-pms@sha256:CHANGE_ME
